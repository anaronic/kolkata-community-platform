# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# JWT secret: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=

# Port for backend server (optional, defaults to 5000)
PORT=5001

# Sentiment service URL (optional, defaults to http://localhost:8000)
SENTIMENT_URL=http://localhost:8000

# Local demo only: return the OTP in the /login response (no SMS provider yet). NEVER set in production.
# EXPOSE_DEV_OTP=true
